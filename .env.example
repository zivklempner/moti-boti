# Your two phone numbers (E.164 format, e.g. +972501234567)
USER1_PHONE=+972XXXXXXXXX
USER1_NAME=Ziv
USER2_PHONE=+972XXXXXXXXX
USER2_NAME=Tal

# WhatsApp group ID — get this from Railway logs after first message in the group
# Looks like: 1234567890-1234567890@g.us
WHATSAPP_GROUP_ID=

# Firebase — paste the values from your Firebase project's service account JSON
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Anthropic API key (for Claude — the bot's brain)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API key (for Whisper voice transcription)
OPENAI_API_KEY=sk-...

# Google Sheets — optional, for automatic expense sync
# Sheet must have a tab named "Raw" with columns: Date, Merchant, Category, Subcategory, Amount, Currency, Paid By, Source, ID
# Share the sheet with GOOGLE_SHEETS_CLIENT_EMAIL (Editor access)
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=sheets-bot@your-project-id.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Admin token — protects the GET /setup-charts endpoint
# Generate any random string, e.g.: openssl rand -hex 32
ADMIN_TOKEN=your-secret-token-here

# Server port (Railway/Render set this automatically)
PORT=3000
